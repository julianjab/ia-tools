{
  "name": "@ia-tools/workspace",
  "version": "0.1.0",
  "description": "Ciclo de vida del checkout donde corre un agente (clone + git worktree por task, locks, limpieza) — port de @ia-flow/workspace — más las Actions que lo enchufan a agent-pipeline",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ia-tools/agent-pipeline": "workspace:*",
    "@ia-tools/fs-tools": "workspace:*",
    "@ia-tools/shell-tools": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
