{
  "name": "@ia-tools/agent-engine-datasource-yaml",
  "version": "0.1.0",
  "description": "Datasource de @ia-tools/agent-engine: una carpeta de YAML traducida a definiciones (fuente, agentes, pipelines)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ia-tools/agent-engine": "workspace:*",
    "@ia-tools/agent-engine-definitions": "workspace:*",
    "yaml": "^2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
