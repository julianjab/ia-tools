{
  "name": "@ia-tools/agent-engine-definitions",
  "version": "0.1.0",
  "description": "El modelo de definiciones de @ia-tools/agent-engine (fuentes, agentes, pipelines) y cómo se arman las entidades, venga de donde venga: los datasources (YAML, SQLite, …) sólo lo producen",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ia-tools/agent-engine": "workspace:*",
    "@ia-tools/telemetry": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
